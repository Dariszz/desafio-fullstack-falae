# Porta exposta pela API fake
MOCK_API_PORT=4000

# Portas públicas da aplicação
WEB_PORT=3000
API_PORT=3001
WORKER_METRICS_PORT=3002

# Atraso normal da análise
MIN_DELAY_MS=250
MAX_DELAY_MS=900

# A cada N requisições, a API retorna 503. Use 0 para desativar.
FAIL_EVERY_N=5

# Rate limit por cliente/IP
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=10000
RETRY_AFTER_SECONDS=2

# Atraso adicional quando x-mock-scenario: slow for utilizado
SLOW_EXTRA_DELAY_MS=2500

# Usado apenas para reiniciar os contadores da API fake
ADMIN_TOKEN=change-me-before-sharing

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=falae
POSTGRES_USER=falae
POSTGRES_PASSWORD=falae_local
DATABASE_URL=postgresql://falae:falae_local@localhost:5432/falae

# Redis
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_PASSWORD=falae_local

# Worker
ANALYSIS_API_URL=http://localhost:4000
ANALYSIS_TIMEOUT_MS=5000
REVIEW_MAX_ATTEMPTS=4
OUTBOX_RETENTION_DAYS=30
